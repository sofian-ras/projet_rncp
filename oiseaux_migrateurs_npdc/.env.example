# Copier en .env pour lancer un bloc depuis l'hote (hors conteneur) tout en
# ciblant l'infra docker-compose :
#   cp .env.example .env
#   python blocs/bc01_infrastructure_donnees/run.py
#
# Dans docker-compose.yml, ces variables sont injectees directement par service
# (avec les noms d'hotes minio / mongodb / mlflow) : ce fichier n'est PAS lu
# par les conteneurs.

# "local" = fichiers de donnees/ uniquement (defaut) ; "objet" = MinIO + MongoDB
STORAGE_BACKEND=objet

# --- MinIO (data lake) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_SECURE=false

# --- MongoDB (entrepot requetable) ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_DB=oiseaux_migrateurs

# --- MLflow (suivi d'experiences BC03) ---
MLFLOW_TRACKING_URI=http://localhost:5000
